# =====================================================================
# MailTrace AI - Docker Ignore Rules
# =====================================================================

# Version control
.git
.gitignore

# Node dependencies & caches
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Python virtual environments & bytecode
backend/venv/
.venv/
venv/
env/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache/

# Build artifacts & distribution
dist/
build/

# Secret & environment files (prevent accidental image baking)
.env
.env.*
!.env.example

# IDE & OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local database files
backend/data/*.db
backend/data/*.sqlite
*.db
*.sqlite
