# =====================================================================
# MailTrace AI - Security & Environment Configuration Reference
# =====================================================================
# Copy this file to .env and configure secret credentials.
# NEVER commit real production keys or .env files to source control.
# =====================================================================

# ---------------------------------------------------------------------
# Geolocation & IP Intelligence Provider Configuration
# Supported Providers:
#   - ipapi: IP-API.com (Pro endpoint via IPAPI_KEY / IP_INTELLIGENCE_API_KEY)
#   - ipinfo: IPInfo.io (Authenticated endpoint via IPINFO_TOKEN / IPINFO_API_KEY)
#   - mock: Offline deterministic mock provider (no key required, for air-gapped / CI environments)
#
# SECRET SERVER-SIDE CREDENTIALS:
# These keys are server-side secrets. The frontend NEVER receives them.
# The backend sanitizes and normalizes all geolocation output.
# ---------------------------------------------------------------------
IP_INTELLIGENCE_PROVIDER=ipapi

# For IP-API Pro:
IPAPI_KEY=your_ipapi_key_here
# Alternative/Legacy variable for IP-API:
IP_INTELLIGENCE_API_KEY=your_ipapi_pro_key_here

# For IPInfo.io:
IPINFO_TOKEN=your_ipinfo_token_here
IPINFO_API_KEY=your_ipinfo_key_here

# Generic fallback credential:
GEOLOCATION_API_KEY=your_geolocation_api_key_here

# Set to true to enforce strict API key requirements across providers
GEOLOCATION_REQUIRE_API_KEY=false

# ---------------------------------------------------------------------
# AI Analyst LLM Configuration (Section 12)
# Supported Providers: gemini, openai, mock
# ---------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------
# Upload Security & File Handling Limits (Section 20)
# ---------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# ---------------------------------------------------------------------
# Rate Limiting Configuration (Section 20)
# ---------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYSIS_PER_MIN=20
RATE_LIMIT_LLM_PER_MIN=10
RATE_LIMIT_INTEL_PER_MIN=60
RATE_LIMIT_GENERAL_PER_MIN=120
