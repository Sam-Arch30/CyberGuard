# =====================================================================
# MailTrace AI - Security & Environment Configuration Reference
# =====================================================================
# Copy this file to .env or configure in your deployment platform
# (Vercel, Render, Railway, AWS, Docker).
# NEVER commit real production keys or secrets to source control.
# =====================================================================

# ---------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vercel / Netlify / Cloudflare Pages)
# ---------------------------------------------------------------------
# In local development: leave empty to use Vite proxy (/api -> localhost:8000).
# In production (e.g. Vercel): set to your backend deployment domain.
# Example: https://mailtrace-api.onrender.com
VITE_API_BASE_URL=

# ---------------------------------------------------------------------
# 2. BACKEND SERVER & CORS CONFIGURATION (Render / Railway / Docker)
# ---------------------------------------------------------------------
# Comma-separated list of allowed production frontend origins.
# Do NOT use wildcard (*) when credentials are used.
# Example: https://mailtrace.vercel.app,https://security.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# In production, default to INFO. All keys and secrets are automatically redacted.
LOG_LEVEL=INFO

# Backend server binding (default: 8000)
BACKEND_PORT=8000

# ---------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Managed PostgreSQL / RDS / Supabase / Neon)
# ---------------------------------------------------------------------
# SQLite (Local Dev / Offline Testing):
DATABASE_URL=sqlite:///backend/data/mailtrace.db

# Managed PostgreSQL (Production - Render / Railway / Supabase / Neon / AWS RDS):
# DATABASE_URL=postgresql://postgres:YOUR_STRONG_PASSWORD@db.example.com:5432/mailtrace
# (Note: postgres:// prefixes are automatically normalized to postgresql://)

# Connection Pool Tuning for Managed PostgreSQL:
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------
# 4. LLM & COPILOT PROVIDER SECRETS
# ---------------------------------------------------------------------
# Supported Providers: gemini, openai, mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Unified API Key (or provider-specific):
LLM_API_KEY=your_llm_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ---------------------------------------------------------------------
# 5. GEOLOCATION & IP INTELLIGENCE PROVIDER CONFIGURATION
# ---------------------------------------------------------------------
# Supported Providers: ipapi, ipinfo, mock
# SECRET SERVER-SIDE CREDENTIALS: Frontend never receives raw provider keys.
IP_INTELLIGENCE_PROVIDER=ipapi

# IP-API Pro:
IP_INTELLIGENCE_API_KEY=your_ipapi_pro_key_here
IPAPI_KEY=your_ipapi_pro_key_here

# IPInfo.io:
IPINFO_TOKEN=your_ipinfo_token_here
IPINFO_API_KEY=your_ipinfo_token_here

# Generic fallback credential:
GEOLOCATION_API_KEY=your_geolocation_api_key_here
GEOLOCATION_REQUIRE_API_KEY=false

# ---------------------------------------------------------------------
# 6. UPLOAD SECURITY & RATE LIMITING
# ---------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYSIS_PER_MIN=20
RATE_LIMIT_LLM_PER_MIN=10
RATE_LIMIT_INTEL_PER_MIN=60
RATE_LIMIT_GENERAL_PER_MIN=120

# Tokens map to server-controlled identities and finite workspace memberships.
CYBERGUARD_REQUIRE_AUTH=true
CYBERGUARD_DEMO_MODE=false
CYBERGUARD_SERVER_CREDENTIALS={}
ALLOW_WORKSPACE_RESET=false
